# ============================================================================
# HealthGo — CLIENT environment (Vite). Only VITE_* vars reach the browser.
#
# LOCAL:  `npm run setup:local` writes .env.local with the local URL + anon key.
#         Copy this file to .env only if you want to add a Google Maps key.
# HOSTED: set these in Cloudflare Pages → Settings → Environment variables.
#
# Server secrets (service role, FIELD_ENCRYPTION_KEY, OTP_PEPPER,
# DISPENSER_SHARED_SECRET, SEED_SECRET, SMS keys) live ONLY in
# supabase/.env.example → supabase/functions/.env (local) or
# `supabase secrets set` (hosted). They must never be prefixed VITE_.
# ============================================================================

# Supabase project URL + PUBLIC anon key (RLS-protected; safe in the client).
# Must match the backend you're using:
#   local  → http://127.0.0.1:54321  + the anon key from `npx supabase status`
#   hosted → https://<project-ref>.supabase.co + Project Settings → API → anon
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps: a PUBLIC client key BY DESIGN. Restrict it (HTTP referrers = your
# Pages domain + localhost; APIs = Maps JavaScript API + Places API).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Consent policy version shown/recorded in the app. MUST equal POLICY_VERSION
# in the Edge Function env.
VITE_POLICY_VERSION=2025-01
VITE_APP_NAME=HealthGo

# --- Welcome-kit QR ---------------------------------------------------------
# The phone DISPLAYS a QR that the vending machine scans. This flag is the one
# place the QR's contents are decided — if the installed machine turns out to
# need a specific format, change this and redeploy; no code changes.
#   json  (default) {"v":1,"token":"...","hospital_id":"...","machine_id":"...","issued_at":"..."}
#   token           the bare release token only
#   url             <VITE_QR_URL_BASE>/r/<token>
VITE_QR_PAYLOAD_MODE=json
# Only used when VITE_QR_PAYLOAD_MODE=url. Defaults to the app's own origin.
VITE_QR_URL_BASE=

# Which dispenser a claim draws stock from. There is no scan step, so the
# machine comes from config. Must match a row in public.machines.
VITE_DEFAULT_MACHINE_ID=HG-TEST-000

# NOTE: demo mode is NOT configured here. DEMO_MODE is a server-side Edge
# Function variable (see supabase/.env.example); the client learns it at
# runtime from the app-config function and shows a "DEMO" badge. This keeps a
# demo build a property of the backend it talks to, not of the bundle.
