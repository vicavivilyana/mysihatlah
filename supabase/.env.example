# ============================================================================
# Edge Function secrets (SERVER-SIDE ONLY — never VITE_, never in the bundle)
#
# LOCAL:  `npm run setup:local` generates supabase/functions/.env from this
#         template (that path is what `supabase functions serve` auto-loads).
# HOSTED: supabase secrets set KEY=value   (one command per key, or --env-file)
#
# Every variable below is REQUIRED unless marked optional. A missing one makes
# the function log "[fn] Missing required environment variable NAME" and fail.
# ============================================================================

# AES-256-GCM key for field-level encryption of survey/appointment data.
# 32 bytes, base64.            Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Pepper for HMAC-SHA-256 OTP hashing (keeps a leaked otp_codes table
# un-brute-forceable). ≥16 chars.  Generate: openssl rand -base64 32
OTP_PEPPER=

# Shared secret the physical dispenser sends in `x-dispenser-secret`.
#                              Generate: openssl rand -hex 32
DISPENSER_SHARED_SECRET=

# Secret required by seed-demo in `x-seed-secret` (so it is never public).
#                              Generate: openssl rand -hex 32
SEED_SECRET=

# Exact browser origins allowed by CORS, comma-separated. Use the Cloudflare
# Pages domain(s) on hosted. "*" is accepted for throwaway dev only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Version stamped on consent rows. MUST equal VITE_POLICY_VERSION in the client.
POLICY_VERSION=2025-01

# OTP delivery: "mock" (pilot; code logged + returned as devCode) or "twilio".
OTP_PROVIDER=mock

# Staging demo mode. Default false. SERVER-SIDE ONLY — never prefix with VITE_.
# true  = otp-verify ALSO accepts the fixed code 000000, so the app can be
#         demoed without a working SMS provider. The OTP row must still exist
#         (otp-request first) and expiry, the 5-attempt cap, rate limiting,
#         HMAC hashing and session/profile creation all behave normally —
#         only the final code comparison is relaxed. The UI shows a permanent
#         "DEMO" badge (served via the app-config function).
# SECURITY: with this on, anyone can sign in as ANY phone number.
#           MUST be false before real users.
DEMO_MODE=false

# Optional. Public origin for signed storage URLs when functions see an internal
# SUPABASE_URL (local Docker: http://kong:8000). setup:local sets it; omit on hosted.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Only when OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Injected automatically by Supabase (local serve + hosted): SUPABASE_URL,
# SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY. Do not set them here.
